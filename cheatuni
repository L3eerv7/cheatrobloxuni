local function drawDevilStar(cx, cy, r, angle)
	local pts = 5
	local step = math.pi * 2 / pts
	local inner = r * 0.38
	local idx = 1
	for i = 0, pts-1 do
		local a0 = angle + i * step
		local a1 = angle + (i + 2) * step
		local x0 = cx + math.cos(a0) * r
		local y0 = cy + math.sin(a0) * r
		local x1 = cx + math.cos(a1) * r
		local y1 = cy + math.sin(a1) * r
		local l = starLines[idx]; idx = idx + 1
		l.From = Vector2.new(x0, y0)
		l.To = Vector2.new(x1, y1)
		l.Color = Color3.fromRGB(255, 60, 60)
		l.Thickness = 2
		l.Visible = true
	end
	for i = 0, pts-1 do
		local a0 = angle + i * step + step/2
		local a1 = angle + (i + 1) * step + step/2
		local x0 = cx + math.cos(a0) * inner
		local y0 = cy + math.sin(a0) * inner
		local x1 = cx + math.cos(a1) * inner
		local y1 = cy + math.sin(a1) * inner
		local l = starLines[idx]; idx = idx + 1
		l.From = Vector2.new(x0, y0)
		l.To = Vector2.new(x1, y1)
		l.Color = Color3.fromRGB(255, 60, 60)
		l.Thickness = 1.5
		l.Visible = true
	end
end

local function drawSwastika(cx, cy, r, angle)
	hideAllCrosshair()
	local armLen = r
	local dirs = {0, math.pi/2, math.pi, 3*math.pi/2}
	local idx = 1
	for _, d in ipairs(dirs) do
		local a = angle + d
		local x1 = cx + math.cos(a) * (armLen * 0.3)
		local y1 = cy + math.sin(a) * (armLen * 0.3)
		local x2 = cx + math.cos(a) * armLen
		local y2 = cy + math.sin(a) * armLen
		local perp = a + math.pi/2
		local hx = x2 + math.cos(perp) * (armLen * 0.35)
		local hy = y2 + math.sin(perp) * (armLen * 0.35)
		local l = swastikaLines[idx]; idx = idx + 1
		l.From = Vector2.new(x1, y1); l.To = Vector2.new(x2, y2)
		l.Color = Color3.fromRGB(255, 60, 60); l.Thickness = 3; l.Visible = true
		local l2 = swastikaLines[idx]; idx = idx + 1
		l2.From = Vector2.new(x2, y2); l2.To = Vector2.new(hx, hy)
		l2.Color = Color3.fromRGB(255, 60, 60); l2.Thickness = 3; l2.Visible = true
	end
	local c1 = swastikaLines[idx]; idx = idx + 1
	c1.From = Vector2.new(cx - r*0.15, cy); c1.To = Vector2.new(cx + r*0.15, cy)
	c1.Color = Color3.fromRGB(255,60,60); c1.Thickness = 2; c1.Visible = true
	local c2 = swastikaLines[idx]; idx = idx + 1
	c2.From = Vector2.new(cx, cy - r*0.15); c2.To = Vector2.new(cx, cy + r*0.15)
	c2.Color = Color3.fromRGB(255,60,60); c2.Thickness = 2; c2.Visible = true
end

local function drawStarOfDavid(cx, cy, r, angle)
	hideAllCrosshair()
	local idx = 1
	for t = 0, 1 do
		local rot = angle + (t == 1 and math.pi or 0)
		for i = 0, 2 do
			local a0 = rot + i * (math.pi * 2 / 3) - math.pi/2
			local a1 = rot + ((i+1) % 3) * (math.pi * 2 / 3) - math.pi/2
			local x0 = cx + math.cos(a0) * r
			local y0 = cy + math.sin(a0) * r
			local x1 = cx + math.cos(a1) * r
			local y1 = cy + math.sin(a1) * r
			local l = davidLines[idx]; idx = idx + 1
			l.From = Vector2.new(x0, y0); l.To = Vector2.new(x1, y1)
			l.Color = Color3.fromRGB(255, 60, 60); l.Thickness = 2; l.Visible = true
		end
	end
end

local flyBv, flyBg
local carBv, carBg

local function hideDrawings(set)
	if not set then return end
	for _, l in ipairs(set.lines) do l.Visible = false end
	set.text.Visible = false
	set.fill.Visible = false
end

RunService.RenderStepped:Connect(function()
	ring.Color = COL.accent
	Config.FOV = Config.FOVdeg
	local center = Camera.ViewportSize / 2
	local camPos = Camera.CFrame.Position

	local char = LocalPlayer.Character
	local rootPart = char and char:FindFirstChild("HumanoidRootPart")
	local humChar = char and char:FindFirstChildOfClass("Humanoid")

	if Config.SpeedHack and humChar then
		humChar.WalkSpeed = Config.SpeedValue
	end

	if Config.FlyEnabled and rootPart then
		if not flyBv then
			flyBv = Instance.new("BodyVelocity")
			flyBv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
			flyBv.Velocity = Vector3.zero
			flyBv.Parent = rootPart
		end
		if not flyBg then
			flyBg = Instance.new("BodyGyro")
			flyBg.MaxTorque = Vector3.new(3e4, 3e4, 3e4)
			flyBg.P = 3000
			flyBg.Parent = rootPart
		end
		flyBg.CFrame = Camera.CFrame
		local moveDir = Vector3.zero
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + Camera.CFrame.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - Camera.CFrame.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - Camera.CFrame.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + Camera.CFrame.RightVector end
		flyBv.Velocity = moveDir * Config.FlySpeed
	else
		if flyBv then flyBv:Destroy(); flyBv = nil end
		if flyBg then flyBg:Destroy(); flyBg = nil end
	end

	local currentVehicleRoot = nil
	if humChar and humChar.SeatPart then
		local seat = humChar.SeatPart
		local vehicleModel = seat.Parent
		if vehicleModel and vehicleModel:IsA("Model") then
			currentVehicleRoot = vehicleModel.PrimaryPart or vehicleModel:FindFirstChild("HumanoidRootPart") or seat
		end
	end

	if Config.CarFly and currentVehicleRoot then
		if not carBv then
			carBv = Instance.new("BodyVelocity")
			carBv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
			carBv.Velocity = Vector3.zero
			carBv.Parent = currentVehicleRoot
		end
		if not carBg then
			carBg = Instance.new("BodyGyro")
			carBg.MaxTorque = Vector3.new(3e4, 3e4, 3e4)
			carBg.P = 3000
			carBg.Parent = currentVehicleRoot
		end
		carBg.CFrame = Camera.CFrame
		local carMoveDir = Vector3.zero
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then carMoveDir = carMoveDir + Camera.CFrame.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then carMoveDir = carMoveDir - Camera.CFrame.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then carMoveDir = carMoveDir - Camera.CFrame.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then carMoveDir = carMoveDir + Camera.CFrame.RightVector end
		carBv.Velocity = carMoveDir * Config.CarFlySpeed
	else
		if carBv then carBv:Destroy(); carBv = nil end
		if carBg then carBg:Destroy(); carBg = nil end
	end

	local bestTarget = nil
	local shortestDist = math.huge
	local mousePos = UserInputService:GetMouseLocation()
	local allVisibleTargets = {}

	for _, t in ipairs(getTargets()) do
		local partToAim = t.RootPart
		if Config.TargetPart == "Tête" then
			partToAim = t.Head
		elseif Config.TargetPart == "Aléatoire" then
			partToAim = (math.random(1, 2) == 1) and t.Head or t.RootPart
		end

		if partToAim then
			local screenPos, onScreen = Camera:WorldToViewportPoint(partToAim.Position)
			if onScreen then
				local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
				local maxR = Camera.ViewportSize.Y / 2 * (Config.FOVdeg / 140)
				if dist <= maxR then
					table.insert(allVisibleTargets, partToAim)
					if dist < shortestDist then
						shortestDist = dist
						bestTarget = partToAim
					end
				end
			end
		end
	end

	if Config.AimEnabled and aimbotActive and bestTarget then
		local goalCFrame = CFrame.lookAt(Camera.CFrame.Position, bestTarget.Position)
		Camera.CFrame = Camera.CFrame:Lerp(goalCFrame, 1 / Config.Smooth)
	end

	if Config.TriggerEnabled and bestTarget and shortestDist < 15 then
		VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
		task.wait(0.02)
		VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
	end

	local isShooting = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
	if aimbotActive and isShooting then
		if Config.MultiBulletTP and #allVisibleTargets > 0 then
			task.spawn(function()
				VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
				task.wait(0.005)
				VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
			end)
		elseif Config.RapidFire and bestTarget then
			task.spawn(function()
				VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
				task.wait(0.01)
				VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
			end)
		end
	end

	if ring then
		if Config.FOVRing then
			ring.Visible = true
			ring.Radius = Camera.ViewportSize.Y / 2 * (Config.FOVdeg / 140)
			ring.Position = center
		else
			ring.Visible = false
		end
	end

	if Config.CrosshairEnabled then
		starAngle = starAngle + 0.05
		hideAllCrosshair()
		if Config.CrosshairType == "Satanic" then
			drawDevilStar(center.X, center.Y, 16, starAngle)
		elseif Config.CrosshairType == "Nazi" then
			drawSwastika(center.X, center.Y, 16, starAngle)
		elseif Config.CrosshairType == "Juifs" then
			drawStarOfDavid(center.X, center.Y, 16, starAngle)
		end
	else
		hideAllCrosshair()
	end

	local activeModels = {}
	if Config.ESPEnabled then
		for i, t in ipairs(getTargets()) do activeModels[t.Model] = i end
	end

	for model, set in pairs(Drawings) do
		local hum = model:FindFirstChildOfClass("Humanoid")
		if not Config.ESPEnabled or not activeModels[model] or (hum and hum.Health <= 0) then
			hideDrawings(set)
		end
	end

	if Config.ESPEnabled then
		local skeletonPairs = {
			{"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"},
			{"UpperTorso", "LeftUpperArm"}, {"LeftUpperArm", "LeftLowerArm"},
			{"UpperTorso", "RightUpperArm"}, {"RightUpperArm", "RightLowerArm"},
			{"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"},
			{"LowerTorso", "RightUpperLeg"}, {"RightUpperLeg", "RightLowerLeg"}
		}

		for _, t in ipairs(getTargets()) do
			local root = t.RootPart
			local head = t.Head
			local set = drawingSet(t.Model)
			local pIdx = activeModels[t.Model] or 0

			hideDrawings(set)

			if root and head then
				local distToPlayer = (camPos - root.Position).Magnitude
				if distToPlayer <= Config.MaxDist then
					local topV, topOn = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.8, 0))
					local botV, botOn = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 2.5, 0))

					if topOn or botOn then
						local topPos = Vector2.new(topV.X, topV.Y)
						local botPos = Vector2.new(botV.X, botV.Y)
						
						local h = math.abs(topPos.Y - botPos.Y)
						local w = h * 0.5
						local lft = botPos.X - w / 2
						local rgt = botPos.X + w / 2

						local vis = isVisible(head)
						local boxCol = colByVis(vis)
						local multiCol = Config.MulticolorESP and colForIndex(pIdx) or boxCol

						set.fill.Size = Vector2.new(w, h)
						set.fill.Position = Vector2.new(lft, topPos.Y)
						set.fill.Visible = true

						local idx = 1
						local function addLine(from, to, color)
							if set.lines[idx] then
								set.lines[idx].Visible = true
								set.lines[idx].Color = color or boxCol
								set.lines[idx].From = from
								set.lines[idx].To = to
								idx = idx + 1
							end
						end

						if Config.ShowBox then
							addLine(Vector2.new(lft, topPos.Y), Vector2.new(rgt, topPos.Y), boxCol)
							addLine(Vector2.new(rgt, topPos.Y), Vector2.new(rgt, botPos.Y), boxCol)
							addLine(Vector2.new(rgt, botPos.Y), Vector2.new(lft, botPos.Y), boxCol)
							addLine(Vector2.new(lft, botPos.Y), Vector2.new(lft, topPos.Y), boxCol)
						end

						if Config.ShowCorner then
							local cw, ch = w * 0.25, h * 0.25
							addLine(Vector2.new(lft, topPos.Y), Vector2.new(lft + cw, topPos.Y), boxCol)
							addLine(Vector2.new(lft, topPos.Y), Vector2.new(lft, topPos.Y + ch), boxCol)
							addLine(Vector2.new(rgt, topPos.Y), Vector2.new(rgt - cw, topPos.Y), boxCol)
							addLine(Vector2.new(rgt, topPos.Y), Vector2.new(rgt, topPos.Y + ch), boxCol)
							addLine(Vector2.new(lft, botPos.Y), Vector2.new(lft + cw, botPos.Y), boxCol)
							addLine(Vector2.new(lft, botPos.Y), Vector2.new(lft, botPos.Y - ch), boxCol)
							addLine(Vector2.new(rgt, botPos.Y), Vector2.new(rgt - cw, botPos.Y), boxCol)
							addLine(Vector2.new(rgt, botPos.Y), Vector2.new(rgt, botPos.Y - ch), boxCol)
						end

						if Config.ShowSkeleton then
							for _, pair in ipairs(skeletonPairs) do
								local p1 = t.Model:FindFirstChild(pair[1], true)
								local p2 = t.Model:FindFirstChild(pair[2], true)
								if p1 and p2 then
									local v1, o1 = Camera:WorldToViewportPoint(p1.Position)
									local v2, o2 = Camera:WorldToViewportPoint(p2.Position)
									if o1 and o2 then
										addLine(Vector2.new(v1.X, v1.Y), Vector2.new(v2.X, v2.Y), multiCol)
									end
								end
							end
						end

						if Config.ShowTracer then
							addLine(Vector2.new(center.X, Camera.ViewportSize.Y), botPos, multiCol)
						end

						if Config.ShowNametag then
							set.text.Visible = true
							set.text.Text = t.Model.Name .. " [" .. math.floor(distToPlayer) .. "m]"
							set.text.Position = Vector2.new(botPos.X, topPos.Y - 18)
							set.text.Color = multiCol
						end
					end
				end
			end
		end
	end
end)
