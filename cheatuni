	fill.Filled = true
	fill.Color = Color3.fromRGB(0, 0, 0)
	fill.Transparency = 0.45
	fill.Visible = false
	Drawings[m] = { lines = lines, text = text, fill = fill }
	m.AncestryChanged:Connect(function()
		if not m.Parent and Drawings[m] then
			for _, l in ipairs(Drawings[m].lines) do l:Remove() end
			Drawings[m].text:Remove()
			Drawings[m].fill:Remove()
			Drawings[m] = nil
		end
	end)
	return Drawings[m]
end

